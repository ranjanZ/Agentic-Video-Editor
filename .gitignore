```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled and build artifacts
*.o
*.obj
*.out
*.so
*.dll
*.dylib

# Dependencies
.venv/
venv/
env/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Coverage reports
.coverage
htmlcov/
coverage/

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# MyPy cache
.mypy_cache/
# Pytest cache
.pytest_cache/
```